# ===============================================
# Echo Environment Variables Configuration
# ===============================================
# In Railway: Configure these under "Variables" tab
# In Docker: Copy this file to .env or Backend/.env

# Port for the server (Railway automatically assigns $PORT in production)
PORT=3000

# Optional: Extra allowed CORS origins (comma-separated)
# Note: Railway domains (*.up.railway.app) and localhost are allowed by default
ALLOWED_ORIGINS=

# --- Speech-to-Text (STT) Keys ---
DEEPGRAM_API_KEY=
SPEECHMATICS_API_KEY=

# --- Large Language Model (LLM) Keys ---
# Provide at least one:
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=

# --- Text-to-Speech (TTS) Keys ---
ELEVENLABS_API_KEY=
